# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_PROJECT_ID=your_supabase_project_id

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@therelonetwork.com
EXECUTIVE_INTAKE_EMAIL=hello@therelonetwork.com
PARTNER_ENQUIRY_EMAIL=hello@therelonetwork.com

# Ask Relo text preview
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
ASK_RELO_USAGE_SECRET=generate_a_long_random_secret

# Ask Relo browser voice (enable only after the published agent is verified)
NEXT_PUBLIC_ASK_RELO_VOICE_ENABLED=1
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_published_retell_agent_id
# Optional separate Retell key carrying the webhook badge. If omitted, the
# server uses RETELL_API_KEY for verification.
RETELL_WEBHOOK_KEY=your_retell_webhook_key

# Beehiiv (newsletter source of truth)
BEEHIIV_API_KEY=your_beehiiv_api_key
BEEHIIV_PUBLICATION_ID=pub_...
BEEHIIV_LANDING_LIST_AUTOMATION_ID=aut_...
BEEHIIV_RELOCATION_INDEX_AUTOMATION_ID=aut_...

# Temporary migration switch for existing Supabase/Resend Landing List leads.
# Leave disabled for new signups; enable only while draining the legacy queue.
ENABLE_LEGACY_LANDING_LIST_SEQUENCE=0

# Cal.com public booking path, for example cal-username/qualification-call
NEXT_PUBLIC_CAL_COM_EMBED_ID=your_cal_embed_id

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEBHOOK_SECRET=your_webhook_secret

# Server-only route authentication
INTERNAL_API_SECRET=generate_a_long_random_secret
CRON_SECRET=generate_a_different_long_random_secret
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=generate_a_strong_password
