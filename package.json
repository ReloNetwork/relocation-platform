{
  "name": "relo-network",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "supabase:types": "test -n \"$SUPABASE_PROJECT_ID\" && npx --yes supabase@latest gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > lib/supabase/database.types.ts",
    "stripe:seed": "node scripts/stripe-seed.js",
    "analyze": "ANALYZE=true next build",
    "seo:validate": "node scripts/validate-seo.js",
    "luxury:validate": "node scripts/luxury-seo-validator.js",
    "luxury:build": "npm run luxury:validate && npm run build",
    "luxury:deploy": "npm run luxury:validate && npm run build"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "@types/nodemailer": "^7.0.2",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^17.2.1",
    "lucide-react": "^0.344.0",
    "next": "^14.2.0",
    "next-seo": "^6.8.0",
    "nodemailer": "^7.0.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-helmet-async": "^2.0.5",
    "resend": "^3.0.0",
    "retell-client-js-sdk": "^2.0.7",
    "schema-dts": "^1.1.5",
    "stripe": "^14.0.0",
    "swr": "^2.2.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "playwright": "^1.41.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
