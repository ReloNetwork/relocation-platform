{
  "name": "relo-network",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run --workspace=askrelo dev",
    "build": "npm run --workspace=askrelo build",
    "start": "npm run --workspace=askrelo start",
    "lint": "npm run --workspace=askrelo lint",
    "typecheck": "npm run --workspace=askrelo type-check",
    "db:setup": "node scripts/setup-db-simple.js",
    "db:seed": "cd apps/askrelo && npx ts-node ../../database/seed.ts",
    "analyze": "cd apps/askrelo && ANALYZE=true npm run build",
    "sitemap": "cd apps/askrelo && npx next-sitemap",
    "seo:validate": "cd apps/askrelo && npm run build && npm run sitemap"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.2",
    "@vercel/analytics": "^1.5.0",
    "next-seo": "^6.8.0",
    "next-sitemap": "^4.2.3",
    "react-helmet-async": "^2.0.5",
    "schema-dts": "^1.1.5"
  }
}
