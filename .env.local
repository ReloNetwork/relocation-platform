# Lindy AI Integration Configuration
# STEP 1: Get your webhook secret from Lindy AI dashboard
# STEP 2: Get your agent ID from Lindy AI agent settings
# STEP 3: Get API key if using Lindy API features (optional)

# Lindy AI Webhook Secret (for verifying webhook authenticity)
LINDY_WEBHOOK_SECRET=ADD_YOUR_LINDY_WEBHOOK_SECRET_HERE

# Lindy AI Agent ID (specific agent to integrate with)
LINDY_AGENT_ID=ADD_YOUR_LINDY_AGENT_ID_HERE

# Lindy AI API Key (optional, for API calls to Lindy)
LINDY_API_KEY=ADD_YOUR_LINDY_API_KEY_HERE

# ==========================================
# Lindy AI Webhook Configuration:
# 1. In Lindy AI dashboard, set webhook URL to: 
#    {NEXT_PUBLIC_BASE_URL}/api/lindy/webhook
# 2. Add your webhook secret above
# 3. Configure events: call_started, call_ended, task_created
# 4. Test integration at: {NEXT_PUBLIC_BASE_URL}/api/lindy/config
# ==========================================

