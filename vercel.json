{
  "buildCommand": "npm run build",
  "installCommand": "npm install", 
  "devCommand": "npm run dev",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/sla-scan",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/message-alerts",
      "schedule": "0 18 * * *"
    }
  ]
}